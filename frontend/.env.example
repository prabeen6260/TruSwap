# Auth0 Configuration
# Get these from your Auth0 dashboard: https://manage.auth0.com/
# Replace with your actual Auth0 domain (e.g., dev-abc123.us.auth0.com)
VITE_AUTH0_DOMAIN=your-auth0-domain.us.auth0.com
# Replace with your Auth0 client ID
VITE_AUTH0_CLIENT_ID=your_auth0_client_id_here
# Optional: Auth0 API audience (should match backend configuration)
VITE_AUTH0_AUDIENCE=https://api.truSwap.com
# Optional: Redirect URI (defaults to current origin if not set)
# VITE_AUTH0_REDIRECT_URI=http://localhost:5173
