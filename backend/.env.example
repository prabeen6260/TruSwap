# MongoDB Configuration
# Replace with your actual MongoDB connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/?appName=AppName
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=truSwap

# Auth0 Configuration
# Get these from your Auth0 dashboard: https://manage.auth0.com/
# Replace with your actual Auth0 domain (e.g., dev-abc123.us.auth0.com)
AUTH0_ISSUER_URI=https://your-domain.us.auth0.com/
# Replace with your Auth0 API identifier
AUTH0_AUDIENCE=https://api.truSwap.com

# PayPal Configuration
# Get your credentials from https://developer.paypal.com/dashboard/applications/sandbox
# For production, use your live credentials
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=http://localhost:8080
